# Puerto HTTP de la API.
PORT=4100

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:5180

# `test` habilita las rutas destructivas de prueba (reset, mutate).
APP_ENV=test

# Latencia simulada, en ms, con una variación aleatoria de ±40 %. En local la
# red es instantánea y así no se ven los problemas reales: respuestas
# desordenadas, scroll más rápido que la carga. Una petición puede anularla con
# la cabecera `x-latency: 0`.
LATENCY_MS=150

# Filas sintéticas de la hoja de casos.
CASES_ROWS=50000

# Cambios ajenos en campos que el lote no toca (G-15):
# merge  → se conservan y se informan en `notices` (por defecto)
# strict → la fila se rechaza como conflicto
CASES_POLICY=merge

# BATCH_LOG=0 apaga el log de cada lote en la consola.
