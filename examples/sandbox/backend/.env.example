# Puerto HTTP de la API.
PORT=4100

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGIN=http://localhost:5180

# Latencia simulada del módulo sandbox, en ms. Se le suma una variación
# aleatoria de ±40 %. En local la red es instantánea y así no se ven los
# problemas reales: respuestas desordenadas, scroll más rápido que la carga.
# Una petición puede anularla con la cabecera `x-sandbox-latency: 0`.
SANDBOX_LATENCY_MS=150

# Filas sintéticas que genera el sandbox al arrancar.
SANDBOX_ROWS=50000

# Cambios ajenos en campos que la petición no toca (§11.14, G-15):
# merge  → se conservan y se informan en `notices` (por defecto)
# strict → la fila se rechaza como conflicto
SANDBOX_REMOTE_CHANGES=merge
