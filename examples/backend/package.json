{
	"name": "@spreadbase/examples-backend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "Un solo servidor para todos los ejemplos de SpreadBase",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"check": "tsc --noEmit",
		"postgres:setup": "tsx src/examples/postgres/db/setup.js",
		"postgres:reset": "tsx src/examples/postgres/db/setup.js --reset"
	},
	"dependencies": {
		"@spreadbase/server": "0.1.0",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^24.13.6",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3"
	}
}
