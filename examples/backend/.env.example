# Variables del servidor de ejemplos. También se leen de SpreadBase/.env (ahí
# van DATABASE_URL y las llaves). Todo tiene valor por defecto.

PORT=4100
CORS_ORIGIN=http://localhost:5180

# `test` habilita las rutas de prueba del ejemplo de casos (reset, mutate).
APP_ENV=test

# Ejemplo de casos: latencia simulada (±40 %; `x-latency: 0` la anula en una
# petición), filas y política de cambios ajenos (merge | strict).
LATENCY_MS=150
CASES_ROWS=50000
CASES_POLICY=merge
# BATCH_LOG=0 apaga el log de cada lote.

# Ejemplo Postgres. Sin ella, ese ejemplo responde 503 y los demás funcionan.
# Supabase: Project Settings → Database → Connection string (URI).
# DATABASE_URL=postgres://postgres:spreadbase@localhost:5433/spreadbase
