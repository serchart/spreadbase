{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"],
		"paths": {
			"@spreadbase/core": ["../../packages/core/src/index.ts"],
			"@spreadbase/server": ["../../packages/server/src/index.ts"]
		}
	},
	"include": ["src", "../../packages/core/src", "../../packages/server/src"]
}
