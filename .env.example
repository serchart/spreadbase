# Copia a .env (no se versiona) y ajusta.

# Postgres de pruebas: fuente de Postgres, lookups y el ejemplo /postgres.
#   docker run -d --name dev-pg -e POSTGRES_PASSWORD=spreadbase -e POSTGRES_DB=spreadbase -p 5433:5432 postgres:16-alpine
DATABASE_URL=postgres://postgres:spreadbase@localhost:5433/spreadbase

# MongoDB de pruebas (mongoSource). Las transacciones exigen replica set; uno de un nodo basta:
#   docker run -d --name sb-mongo -p 27019:27017 mongo:7 --replSet rs0
#   docker exec sb-mongo mongosh --eval "rs.initiate()"
MONGO_URL=mongodb://localhost:27019/?directConnection=true

# Un PDF real para la prueba opcional de extracción (no se versiona: es de un cliente).
# EXTRACTION_PDF=/ruta/al/boletin.pdf
