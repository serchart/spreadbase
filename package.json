{
	"name": "spreadbase-monorepo",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"workspaces": [
		"packages/core",
		"packages/server",
		"packages/client",
		"examples/backend",
		"examples/frontend",
		"tests"
	],
	"scripts": {
		"check": "npm run check --workspaces --if-present",
		"back": "npm run dev -w @spreadbase/examples-backend",
		"front": "npm run dev -w @spreadbase/examples-frontend",
		"postgres:setup": "npm run postgres:setup -w @spreadbase/examples-backend",
		"postgres:reset": "npm run postgres:reset -w @spreadbase/examples-backend",
		"test": "npm test -w @spreadbase/tests",
		"test:unit": "npm test -w @spreadbase/client"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
