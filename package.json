{
	"name": "spreadbase-monorepo",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"workspaces": [
		"packages/core",
		"packages/server",
		"packages/client",
		"playground/backend",
		"playground/frontend",
		"examples/basic/backend",
		"examples/basic/frontend",
		"examples/postgres/backend",
		"examples/postgres/frontend",
		"tests"
	],
	"scripts": {
		"check": "npm run check --workspaces --if-present",
		"test": "npm test -w @spreadbase/tests",
		"test:unit": "npm test -w @spreadbase/client",
		"playground:back": "npm run dev -w @spreadbase/playground-backend",
		"playground:front": "npm run dev -w @spreadbase/playground-frontend",
		"basic:back": "npm run dev -w @spreadbase/example-basic-backend",
		"basic:front": "npm run dev -w @spreadbase/example-basic-frontend",
		"postgres:setup": "npm run setup -w @spreadbase/example-postgres-backend",
		"postgres:reset": "npm run setup -w @spreadbase/example-postgres-backend -- --reset",
		"postgres:back": "npm run dev -w @spreadbase/example-postgres-backend",
		"postgres:front": "npm run dev -w @spreadbase/example-postgres-frontend"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
